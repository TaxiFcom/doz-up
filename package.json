{
  "name": "doz-up-gateway",
  "version": "3.0.0",
  "description": "DOZ UP Gateway - Enterprise Screenshot & Media Platform",
  "main": "gateway.js",
  "scripts": {
    "start": "node gateway.js",
    "dev": "node --watch gateway.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "worker": "node infrastructure/jobs/worker.js",
    "migrate:json": "node migration/migrate.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && gradlew assembleRelease",
    "android:bundle": "cd android && gradlew bundleRelease",
    "android:run": "npx cap run android",
    "android:icons": "npx capacitor-assets generate",
    "extension:build": "cd extension && build.bat",
    "extension:pack": "cd extension && powershell Compress-Archive -Path build/* -DestinationPath doz-up-extension.zip -Force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@capacitor/android": "^8.0.1",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@prisma/client": "^5.22.0",
    "basic-ftp": "^5.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.25.0",
    "checkout-sdk-node": "^3.0.3",
    "clean-css": "^5.3.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "html-minifier-terser": "^7.2.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^21.11.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^20.2.0",
    "terser": "^5.46.0",
    "uuid": "^9.0.0",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0"
  },
  "capacitor": {
    "appId": "com.doz.up",
    "appName": "DOZ UP"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
