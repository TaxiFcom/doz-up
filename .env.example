# ─── DOZ UP Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values before starting the server.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Application environment: development | production | test
NODE_ENV=development

# HTTP port the Express server listens on
PORT=3000

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret — minimum 32 characters, use a random 64-char string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_string_before_going_to_production

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dozup_db

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL for sessions, queues, and caching
REDIS_URL=redis://localhost:6379

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# Stripe secret key — starts with sk_live_ in production, sk_test_ in development
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret — from the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.doz.com
SMTP_PASS=your_smtp_password

# ─── S3 / Object Storage ─────────────────────────────────────────────────────
# Used for storing uploaded screenshots and sync files
S3_BUCKET=dozup-uploads
S3_REGION=eu-west-1
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=your_s3_secret_key

# ─── Upload Limits ────────────────────────────────────────────────────────────
# Maximum size for regular image/screenshot uploads (MB)
UPLOAD_MAX_SIZE_MB=10
# Maximum size for mirror/dev sync file transfers (MB)
UPLOAD_MAX_SYNC_SIZE_MB=50

# ─── Public URLs ──────────────────────────────────────────────────────────────
# The canonical public URL of this server (no trailing slash)
BASE_URL=https://up.doz.com

# ─── Admin Panel ──────────────────────────────────────────────────────────────
# Secret token to access the admin dashboard (leave empty to disable)
ADMIN_PANEL_SECRET=

# ─── AI Services ──────────────────────────────────────────────────────────────
# Anthropic Claude API key for the neural-growth and ai-health-monitor services
ANTHROPIC_API_KEY=sk-ant-...

# ─── PM2 / Deployment ─────────────────────────────────────────────────────────
# Absolute path to the app root — used by ecosystem.config.js when __dirname is unavailable
# APP_DIR=/home/ubuntu/doz-up
